# ─── Required ─────────────────────────────────────────────────────────────
# Use your provider's POOLED connection string on serverless (Neon/Supabase
# pooler endpoint) — a serverless function opens a new connection per
# invocation and will exhaust a direct Postgres connection limit.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production

# Frontend origin(s) allowed by CORS — comma-separated.
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# ─── Optional ─────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Regex for dynamic origins, e.g. Vercel preview deployments.
# Keep it anchored to your own project so it can't match anyone else's app.
# FRONTEND_ORIGIN_REGEX=https://ev-crm-.*-yourteam\.vercel\.app

# Google Sheets import — leave blank if unused.
# Locally this may be a path to the key file; on Vercel paste the key's
# raw JSON (the filesystem is read-only, so a file path won't work there).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
