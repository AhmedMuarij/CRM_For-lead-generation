# ─── Required ─────────────────────────────────────────────────────────────
# IMPORTANT (Fix #10): Use the POOLED / SUPAVISOR connection string, NOT the
# direct Postgres string. A serverless function opens a new connection per
# invocation and will exhaust the direct connection limit (~60 on Supabase).
#
# Supabase — use the Supavisor session-mode URL (port 6543 or the pooler
# hostname on port 5432 shown in Project Settings → Database → Connection pooling):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
#
# Neon — use the pooled string (host contains "-pooler"):
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
# Direct connections (port 5432 without a pooler host) will work locally but
# will cause "FATAL: remaining connection slots are reserved" under load on Vercel.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production

# Frontend origin(s) allowed by CORS — comma-separated.
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# ─── Optional ─────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Regex for dynamic origins, e.g. Vercel preview deployments.
# Keep it anchored to your own project so it can't match anyone else's app.
# FRONTEND_ORIGIN_REGEX=https://ev-crm-.*-yourteam\.vercel\.app

# Google Sheets import — leave blank if unused.
# Locally this may be a path to the key file; on Vercel paste the key's
# raw JSON (the filesystem is read-only, so a file path won't work there).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
