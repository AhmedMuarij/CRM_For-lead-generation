# EV CRM Backend — Railway deployment

# ─── Required ─────────────────────────────────────────────────────────────
DATABASE_URL=                      # Paste from Railway PostgreSQL or Supabase
SECRET_KEY=                        # Generate: python -c "import secrets; print(secrets.token_hex(32))"
FRONTEND_ORIGIN=                   # Your Vercel URL: https://your-app.vercel.app

# ─── Optional ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480
GOOGLE_SERVICE_ACCOUNT_JSON=       # Leave blank if not using Google Sheets
GOOGLE_SHEET_ID=                   # Leave blank if not using Google Sheets
